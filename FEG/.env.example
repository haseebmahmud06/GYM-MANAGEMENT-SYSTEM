# ---------------------------------------------------------------------------
# Fitness First Gym - Frontend environment variables
# Copy this file to `.env` and fill in your values.
# ---------------------------------------------------------------------------

# Base URL of the Django REST API. Leave as '/api' to use the Vite dev proxy.
VITE_API_URL=/api

# ----- Google OAuth (Sign in with Google) -----
# Set this to your Google OAuth 2.0 Web Client ID (from Google Cloud Console).
# When set, the "Sign in with Google" button appears on Login/Register.
# NOTE: this must match the GOOGLE_CLIENT_ID configured on the Django backend
# (and the authorized JavaScript origins/redirect URIs in Google Cloud Console).
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
