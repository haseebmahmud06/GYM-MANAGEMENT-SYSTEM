# ---------------------------------------------------------------------------
# Fitness First Gym - Backend environment variables (Django)
# Copy to `.env` (next to manage.py) and fill in your values.
# ---------------------------------------------------------------------------

# SECURITY - generate a strong random key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (defaults to SQLite unless DB_ENGINE is postgresql)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# CORS
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Email (dev uses console backend by default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ----- Google OAuth (Sign in with Google) -----
# Create an OAuth 2.0 client in Google Cloud Console (Application type: Web).
# Add your frontend origin (e.g. http://localhost:3000) as an authorized
# JavaScript origin. Use the same client ID here and in the frontend `.env`
# as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
